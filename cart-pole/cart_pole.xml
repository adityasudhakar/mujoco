<mujoco model="Hands-on: cart and pole (no balancing controller)">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <statistic center="0 0 0.6" extent="2.4"/>
  <visual>
    <global azimuth="90" elevation="-18" offwidth="960" offheight="640"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3"/>
  </visual>
  <default>
    <geom friction="0.7 0.02 0.001"/>
    <joint damping="0.01"/>
  </default>
  <asset>
    <texture name="checker" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.15 0.20 0.25" rgb2="0.22 0.29 0.35"/>
    <material name="floor" texture="checker" texrepeat="8 8"/>
  </asset>
  <worldbody>
    <light pos="-1 -2 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor"/>
    <!-- The rail is visual; the slide joint constrains the cart to left/right. -->
    <geom name="rail_front" type="box" pos="0 -0.12 0.08" size="2.4 0.025 0.02"
          rgba="0.6 0.65 0.7 1" contype="0" conaffinity="0"/>
    <geom name="rail_back" type="box" pos="0 0.12 0.08" size="2.4 0.025 0.02"
          rgba="0.6 0.65 0.7 1" contype="0" conaffinity="0"/>
    <body name="cart" pos="0 0 0.18">
      <joint name="cart_slide" type="slide" axis="1 0 0" range="-2.1 2.1" damping="0.05"/>
      <!-- Box size is HALF-width, HALF-depth, HALF-height, in metres. -->
      <geom name="cart_box" type="box" size="0.22 0.16 0.08" mass="1"
            rgba="0.10 0.55 0.95 1"/>
      <body name="pole" pos="0 0 0.10">
        <joint name="pole_hinge" type="hinge" axis="0 1 0" damping="0.005"/>
        <!-- A 0.9 m pole, standing up from its hinge. -->
        <geom name="pole_rod" type="capsule" fromto="0 0 0 0 0 0.9" size="0.025"
              mass="0.25" rgba="1 0.75 0.1 1"/>
        <geom name="pole_tip" type="sphere" pos="0 0 0.9" size="0.045"
              mass="0.04" rgba="0.95 0.20 0.12 1"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="cart" body2="pole"/>
  </contact>
  <actuator>
    <!-- Manual force slider in the viewer's Control panel; initially zero. -->
    <motor name="cart_motor" joint="cart_slide" ctrlrange="-100 100"/>
  </actuator>
  <sensor>
    <jointpos name="cart_position" joint="cart_slide"/>
    <jointpos name="pole_angle" joint="pole_hinge"/>
    <jointvel name="pole_angular_speed" joint="pole_hinge"/>
  </sensor>
</mujoco>
